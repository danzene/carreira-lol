# Carreira LoL — variáveis de ambiente (TEMPLATE)
# Copie este arquivo para .env.local e preencha com os valores do SEU projeto
# Supabase. NUNCA commite o .env.local (já está no .gitignore).

# Supabase — projeto NOVO, exclusivo do Carreira LoL (não reaproveitar o do draft lol).
# Pegue em: Supabase → seu projeto → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service_role (SÓ SERVIDOR — nunca NEXT_PUBLIC). Liga o painel admin.
# Settings → API → service_role. Sem ela, o admin fica desligado (o jogo funciona).
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago (loja/Pix — SÓ SERVIDOR). Suas Integrações → sua aplicação.
# Comece com as credenciais de TESTE; troque pelas de produção quando for pra valer.
MP_ACCESS_TOKEN=
# Assinatura secreta do webhook (Webhooks → configurar notificação → chave secreta).
# Sem ela, o webhook rejeita tudo (fail-closed) — configure antes de vender.
MP_WEBHOOK_SECRET=
